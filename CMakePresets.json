{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Default Debug",
      "description": "Debug build with Qt6",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "release",
      "displayName": "Default Release",
      "description": "Release build with Qt6",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "static",
      "displayName": "Static Release",
      "description": "Release build linked against static Qt in $HOME/opt/qt6-static",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/static",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_PREFIX_PATH": "$env{HOME}/opt/qt6-static;$env{HOME}/opt/static-deps",
        "TIFFVIEW_STATIC": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "static",
      "configurePreset": "static"
    }
  ]
}
